{
  "name": "@qwexs/kysely-bun-psql",
  "version": "2.1.0",
  "packageManager": "bun@1.4.4",
  "description": "Kysely dialect for PostgreSQL using Bun's native SQL client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwexs/kysely-bun-psql.git"
  },
  "homepage": "https://github.com/qwexs/kysely-bun-psql",
  "author": "qwexs <qwexlock@gmail.com>",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kysely",
    "bun",
    "psql",
    "postgresql",
    "dialect"
  ],
  "scripts": {
    "build": "bun --bun run build.config.ts",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "prepare": "bun --bun run build",
    "prepack": "bun --bun run build",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test ./tests/unit",
    "test:integration": "bun test --preload ./tests/setup.ts ./tests/impl.test.ts ./tests/dialect.test.ts ./tests/bigint.test.ts ./tests/native-parameters.test.ts ./tests/native-driver.test.ts ./tests/native-connection.test.ts ./tests/numeric-arrays.test.ts",
    "test:dialect": "bun test --preload ./tests/setup.ts ./tests/dialect.test.ts",
    "test:package": "bun run build && bun test ./tests/package-smoke.test.ts ./tests/git-install-smoke.test.ts",
    "test:ci": "bun run fmt:check && bun run type-check && bun run test && bun run test:package",
    "type-check": "bun check --no-script",
    "version:patch": "npm version patch -m 'Release v%s'",
    "version:minor": "npm version minor -m 'Release v%s'",
    "version:major": "npm version major -m 'Release v%s'"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "peerDependencies": {
    "kysely": ">=0.29.7 <0.30"
  },
  "dependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "kysely": "0.29.7"
  },
  "sideEffects": false,
  "directories": {
    "test": "tests"
  },
  "bugs": {
    "url": "https://github.com/qwexs/kysely-bun-psql/issues"
  }
}
